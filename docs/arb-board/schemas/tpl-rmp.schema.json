{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provena-foundry/arb-board/tpl-rmp/1.0.0",
  "title": "TPL-RMP Remediation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "review_id",
    "authoring_team_contact",
    "date_submitted",
    "items",
    "ma_reviewer",
    "ma_decision",
    "ma_signature_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "authoring_team_contact": {
      "type": "string",
      "minLength": 1
    },
    "date_submitted": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "root_cause",
          "planned_changes",
          "responsible_person",
          "target_completion_date",
          "planned_resolution_evidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "root_cause": {
            "type": "string",
            "minLength": 1
          },
          "planned_changes": {
            "type": "string",
            "minLength": 1
          },
          "responsible_person": {
            "type": "string",
            "minLength": 1
          },
          "target_completion_date": {
            "type": "string",
            "format": "date"
          },
          "planned_resolution_evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ma_reviewer": {
      "type": "string",
      "minLength": 1
    },
    "ma_decision": {
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "ma_signature_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
