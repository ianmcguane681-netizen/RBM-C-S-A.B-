# Python
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
data/project_exchange.db
data/sv_engine.db
data/exports/
examples/sv_engine/*.db
*.log
*.sqlite3
.pytest-tmp-rbe/
rbe-bundles/
.DS_Store

# Node.js
node_modules/

# TypeScript build outputs — generated files; must not be committed
*.tsbuildinfo
dist/
*.d.ts.map

# Live review board store (the exported bundle is committed, the database is not)
data/review_board*.sqlite3

# The monitor's memory. Ignored by default because it records WHAT IS BEING WATCHED, and
# on a public repository that publishes a holder's positions. Commit it deliberately if the
# change history is wanted in git; it is plain JSON and diffs readably.
data/monitor-ledger.json
# Same reasoning as the ledger: it records which opportunities have been put in
# front of you and which you acted on, and this repository is public.
data/seen-register.json

data/portfolio.json

data/orchestrator.json

data/theses.json

data/breakers*.json
data/HALT

# The reaper configuration: watchlists, sports, balances and a wallet address. Same
# reasoning as the ledger — it records what is being watched and how much is behind it,
# and this repository is public. examples/reapers.example.json is the committed shape.
data/reapers.json

# What was placed and what it returned. Same reasoning as the seen register: it names
# subjects and stakes, and this repository is public. The receipt beside it is committed —
# it carries counts and dates, never subjects.
data/outcomes.json

# The last odds-API quota reading, kept so the spending floor survives the process that
# took it. A count and a timestamp — no subject and no credential — but it is operational
# state that belongs to one machine's key, and it changes on every scan.
data/oddsapi-usage.json

# The run journal: what ran, what each lane reported, and what was submitted. It names
# subjects and stakes exactly as the outcome ledger does, and this repository is public.
# A record rather than a source of truth — data/outcomes.json remains the ledger.
data/journal.sqlite3
data/journal.sqlite3-wal
data/journal.sqlite3-shm

# The supervisor's heartbeat: a pid, two timestamps and a tick count. No subject and no
# stake, but it belongs to one running machine and changes every minute.
data/heartbeat.json

# What you have already been told, and what became of every send. Both are records: the
# subjects of live opportunities travel through them, so neither belongs in a public repo.
data/announced.json
data/notifications.json

# Prospector's output and its register. Both carry the names, addresses and phone numbers
# of real businesses that have not asked to be in a public repository, and the register in
# particular is a list of who has been approached. Same rule as the seen register above:
# the data is gitignored, the code that produces it is not.
data/prepared.json
dossiers/

# Prospector's engagement ledger and its monitoring baselines. The first is a list of real
# businesses, what they agreed to and who at that business agreed it; the second is one
# file per live client site. Same rule as the seen register: the data is gitignored, the
# code that produces it is not.
data/engagements.json
data/watch/

# Prospector's rates. Not subjects, but it is what an hour of somebody's time is worth and
# what they charge, which is not public-repository material. costs.example.json is the
# committed shape.
data/costs.json
